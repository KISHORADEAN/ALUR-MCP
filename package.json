{
  "name": "alur-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Firefox automation assistant for the ALUR pseudocode lab",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts start",
    "inspect": "tsx src/index.ts inspect",
    "dry-run": "tsx src/index.ts dry-run",
    "mcp": "tsx src/mcp-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_LIVE_ALUR=1 vitest run tests/integration/alur-mcp.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "smoke:openrouter": "node scripts/smoke-openrouter.js",
    "smoke:chat": "node scripts/smoke-chat.js",
    "env:check": "node scripts/check-env.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^18.0.9",
    "openai": "^7.45.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
